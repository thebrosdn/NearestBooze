# Copy to .env for local development. EXPO_PUBLIC_* vars are inlined into the
# JS bundle at build time, so never put secrets here — only values that are
# safe to ship inside the app binary.

# Sentry DSN. Leave empty to disable crash reporting entirely.
# Get one at https://sentry.io → Project Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
